import { useTranslatedPath, useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
---

<main id="main" tabindex="-1">
  <section class="hero" aria-label={t("azkena.hero.ariaLabel")}>
    <div class="hero__gradient" aria-hidden="true">
      <div class="hero__circle hero__circle--1"></div>
      <div class="hero__circle hero__circle--2"></div>
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <a href={tp("/")} class="hero__back">
          <svg
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M10 3L6 8l4 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {t("azkena.hero.back")}
        </a>
        <p class="eyebrow eyebrow--light hero__eyebrow">
          {t("azkena.hero.eyebrow")}
        </p>
        <h1 class="hero__title">Azkena</h1>
        <p class="hero__subtitle">{t("azkena.hero.subtitle")}</p>
        <div class="hero__actions">
          <a href="https://github.com/Pilotariak/azkena" class="btn btn--white">
            {t("azkena.hero.github")}
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 8h10M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
          <a href="#overview" class="btn btn--ghost-white">{
            t("azkena.hero.explore")
          }</a>
        </div>
      </div>
      <div class="server-card" aria-hidden="true">
        <div class="server-card__bar">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <p class="server-card__label">MCP SERVER</p>
        <p class="server-card__name">pilotariak/azkena</p>
        <div class="server-card__status"><i></i> online · read-only</div>
        <div class="server-card__item">
          <code>tools</code>
          <span>competitions · results · players</span>
        </div>
        <div class="server-card__item">
          <code>resources</code>
          <span>community context · documentation</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="overview" aria-labelledby="overview-title">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">{t("azkena.overview.eyebrow")}</p>
        <h2 class="section-header__title" id="overview-title">
          {t("azkena.overview.title")}
        </h2>
        <p class="section-header__subtitle">{t("azkena.overview.subtitle")}</p>
      </div>
      <ol class="flow reveal reveal--delay-1">
        <li class="flow__item">
          <div class="flow__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path
                d="M7 18h10M8 21h8M9 3h6l1 11H8L9 3z"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linejoin="round"
              />
              <path
                d="M10 7h4"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <div>
            <p class="flow__number">01</p>
            <h3>{t("azkena.overview.client.title")}</h3>
            <p>{t("azkena.overview.client.desc")}</p>
          </div>
        </li>
        <li class="flow__arrow" aria-hidden="true">→</li>
        <li class="flow__item flow__item--featured">
          <div class="flow__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <rect
                x="3"
                y="3"
                width="18"
                height="18"
                rx="3"
                stroke="currentColor"
                stroke-width="1.75"
              />
              <path
                d="M8 8h8M8 12h8M8 16h5"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <div>
            <p class="flow__number">02</p>
            <h3>{t("azkena.overview.server.title")}</h3>
            <p>{t("azkena.overview.server.desc")}</p>
          </div>
        </li>
        <li class="flow__arrow" aria-hidden="true">→</li>
        <li class="flow__item">
          <div class="flow__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <ellipse
                cx="12"
                cy="5"
                rx="8"
                ry="3"
                stroke="currentColor"
                stroke-width="1.75"
              />
              <path
                d="M4 5v7c0 1.66 3.58 3 8 3s8-1.34 8-3V5M4 12v7c0 1.66 3.58 3 8 3s8-1.34 8-3v-7"
                stroke="currentColor"
                stroke-width="1.75"
              />
            </svg>
          </div>
          <div>
            <p class="flow__number">03</p>
            <h3>{t("azkena.overview.data.title")}</h3>
            <p>{t("azkena.overview.data.desc")}</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section
    class="section section--alt"
    id="capabilities"
    aria-labelledby="capabilities-title"
  >
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">{t("azkena.capabilities.eyebrow")}</p>
        <h2 class="section-header__title" id="capabilities-title">
          {t("azkena.capabilities.title")}
        </h2>
        <p class="section-header__subtitle">
          {t("azkena.capabilities.subtitle")}
        </p>
      </div>
      <div class="capabilities reveal reveal--delay-1">
        <article class="capability">
          <div
            class="capability__icon capability__icon--red"
            aria-hidden="true"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 3v18M3 12h18"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
              <circle
                cx="12"
                cy="12"
                r="8"
                stroke="currentColor"
                stroke-width="1.75"
              />
            </svg>
          </div>
          <h3>{t("azkena.capabilities.tools.title")}</h3>
          <p>{t("azkena.capabilities.tools.desc")}</p>
        </article>
        <article class="capability">
          <div
            class="capability__icon capability__icon--amber"
            aria-hidden="true"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path
                d="M4 4h16v16H4zM8 8h8M8 12h5"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <h3>{t("azkena.capabilities.resources.title")}</h3>
          <p>{t("azkena.capabilities.resources.desc")}</p>
        </article>
        <article class="capability">
          <div
            class="capability__icon capability__icon--green"
            aria-hidden="true"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <rect
                x="4"
                y="10"
                width="16"
                height="11"
                rx="2"
                stroke="currentColor"
                stroke-width="1.75"
              />
              <path
                d="M8 10V7a4 4 0 018 0v3"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <h3>{t("azkena.capabilities.readonly.title")}</h3>
          <p>{t("azkena.capabilities.readonly.desc")}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="discovery-title">
    <div class="container discovery reveal">
      <div class="discovery__copy">
        <p class="eyebrow">{t("azkena.discovery.eyebrow")}</p>
        <h2 id="discovery-title">{t("azkena.discovery.title")}</h2>
        <p>{t("azkena.discovery.subtitle")}</p>
      </div>
      <article class="discovery__card">
        <div class="discovery__mark" aria-hidden="true"></div>
        <h3>{t("azkena.discovery.card.title")}</h3>
        <p>{t("azkena.discovery.card.desc")}</p>
        <a href="/.well-known/mcp/server-card.json" class="discovery__link">{
            t("azkena.discovery.card.cta")
          }
          <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="section" id="contribute" aria-labelledby="contribute-title">
    <div class="container">
      <div class="contrib-layout">
        <div class="contrib-header reveal">
          <p class="eyebrow">{t("azkena.contribute.eyebrow")}</p>
          <h2 class="contrib-header__title" id="contribute-title">
            {t("azkena.contribute.title")}
          </h2>
          <p class="contrib-header__subtitle">
            {t("azkena.contribute.subtitle")}
          </p>
          <div class="contrib-header__actions">
            <a
              href="https://github.com/Pilotariak/azkena"
              class="btn btn--primary"
            >
              {t("azkena.contribute.github")}
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
            <a href={tp("/")} class="btn btn--secondary">{
              t("azkena.contribute.back")
            }</a>
          </div>
        </div>
        <div class="contrib-steps reveal reveal--delay-1">
          <div class="contrib-step">
            <div class="contrib-step__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <rect
                  x="2"
                  y="4"
                  width="20"
                  height="16"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="1.75"
                />
                <path
                  d="M6 9l4 3-4 3M13 15h5"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                />
              </svg>
            </div>
            <div>
              <h3 class="contrib-step__title">
                {t("azkena.contribute.step1.title")}
              </h3>
              <p class="contrib-step__desc">
                {t("azkena.contribute.step1.desc")}
              </p>
            </div>
          </div>
          <div class="contrib-step">
            <div class="contrib-step__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <circle
                  cx="12"
                  cy="12"
                  r="9"
                  stroke="currentColor"
                  stroke-width="1.75"
                />
                <path
                  d="M12 8v4M12 16h.01"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                />
              </svg>
            </div>
            <div>
              <h3 class="contrib-step__title">
                {t("azkena.contribute.step2.title")}
              </h3>
              <p class="contrib-step__desc">
                {t("azkena.contribute.step2.desc")}
              </p>
            </div>
          </div>
          <div class="contrib-step">
            <div class="contrib-step__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <circle
                  cx="6"
                  cy="6"
                  r="3"
                  stroke="currentColor"
                  stroke-width="1.75"
                />
                <circle
                  cx="6"
                  cy="18"
                  r="3"
                  stroke="currentColor"
                  stroke-width="1.75"
                />
                <circle
                  cx="18"
                  cy="9"
                  r="3"
                  stroke="currentColor"
                  stroke-width="1.75"
                />
                <path
                  d="M6 9v6M9 7.5l6-1.5"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                />
              </svg>
            </div>
            <div>
              <h3 class="contrib-step__title">
                {t("azkena.contribute.step3.title")}
              </h3>
              <p class="contrib-step__desc">
                {t("azkena.contribute.step3.desc")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      entry.target.classList.add("is-visible");
      observer.unobserve(entry.target);
    }
  });
}, { threshold: 0.1 });
document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>

<style>
.hero {
  position: relative;
  overflow: hidden;
  padding-top: 120px;
}
.hero__gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    var(--red) 0%,
    var(--red-dark) 45%,
    var(--cream) 100%
  );
  z-index: 0;
}
.hero__circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  pointer-events: none;
}
.hero__circle--1 {
  width: 420px;
  height: 420px;
  top: -80px;
  right: -80px;
}
.hero__circle--2 {
  width: 240px;
  height: 240px;
  top: 180px;
  left: -60px;
}
.hero__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  gap: var(--space-3xl);
  align-items: end;
}
.hero__content {
  padding-bottom: 80px;
  max-width: 600px;
}
.hero__back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 44px;
  font-size: 13px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.65);
  margin-bottom: var(--space-lg);
  transition: color 150ms ease;
}
.hero__back:hover {
  color: var(--white);
}
.hero__eyebrow {
  margin-bottom: var(--space-md);
}
.hero__title {
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 900;
  color: var(--white);
  line-height: 1;
  letter-spacing: -1.5px;
  margin-bottom: var(--space-lg);
}
.hero__subtitle {
  font-size: 18px;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.82);
  margin-bottom: var(--space-xl);
}
.hero__actions, .contribute__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}
.btn--white {
  color: var(--red);
  background: var(--white);
  box-shadow: 0 4px 16px rgba(103, 18, 31, 0.18);
}
.btn--white:hover {
  background: var(--cream);
  transform: translateY(-1px);
}
.server-card {
  width: 360px;
  padding: 0 24px 24px;
  background: var(--panel);
  color: var(--white);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 16px;
  box-shadow: 0 24px 64px rgba(103, 18, 31, 0.22);
  transform: translateY(32px);
}
.server-card__bar {
  height: 46px;
  display: flex;
  gap: 6px;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  margin-bottom: 22px;
}
.server-card__bar span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
}
.server-card__label {
  color: rgba(255, 255, 255, 0.55);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
}
.server-card__name {
  font: 700 18px ui-monospace, SFMono-Regular, Menlo, monospace;
  margin: 5px 0 16px;
}
.server-card__status {
  display: flex;
  gap: 7px;
  align-items: center;
  color: #b7e6d4;
  font: 600 12px ui-monospace, SFMono-Regular, Menlo, monospace;
  margin-bottom: 20px;
}
.server-card__status i {
  display: block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
}
.server-card__item {
  padding: 12px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: grid;
  gap: 5px;
}
.server-card__item code {
  color: #f7b8c3;
  font-size: 12px;
}
.server-card__item span {
  color: rgba(255, 255, 255, 0.72);
  font-size: 12px;
}
.flow {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  gap: var(--space-md);
  align-items: stretch;
  list-style: none;
  padding: 0;
}
.flow__item {
  padding: var(--space-xl);
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}
.flow__item--featured {
  border-color: var(--red);
}
.flow__icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-md);
  background: var(--red-soft);
  color: var(--red);
  margin-bottom: var(--space-lg);
}
.flow__number {
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.2px;
  margin-bottom: var(--space-xs);
}
.flow h3, .capability h3, .discovery h3 {
  color: var(--ink);
  font-size: 20px;
  line-height: 1.25;
  margin-bottom: var(--space-xs);
}
.flow p:last-child,
.capability p,
.discovery__copy > p:last-child,
.discovery__card p,
.contribute > p {
  color: var(--muted);
  font-size: 15px;
  line-height: 1.65;
}
.flow__arrow {
  align-self: center;
  color: var(--red);
  font-size: 26px;
  font-weight: 700;
}
.capabilities {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-lg);
}
.capability {
  padding: var(--space-xl);
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  transition: border-color 150ms ease, box-shadow 150ms ease;
}
.capability:hover {
  border-color: var(--red);
  box-shadow: 0 4px 12px rgba(103, 18, 31, 0.07);
}
.capability__icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-lg);
}
.capability__icon--red {
  background: var(--red-soft);
  color: var(--red);
}
.capability__icon--amber {
  background: var(--amber-soft);
  color: #8a5e00;
}
.capability__icon--green {
  background: var(--green-soft);
  color: var(--green);
}
.discovery {
  display: grid;
  grid-template-columns: 1fr 380px;
  align-items: center;
  gap: var(--space-3xl);
}
.discovery__copy h2, .contrib-header__title {
  color: var(--ink);
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 800;
  letter-spacing: -0.5px;
  line-height: 1.15;
  margin: var(--space-md) 0 var(--space-lg);
}
.discovery__card {
  position: relative;
  padding: var(--space-xl);
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}
.discovery__mark {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--red);
  margin-bottom: var(--space-lg);
}
.discovery__mark::after {
  content: "";
  display: block;
  width: 14px;
  height: 14px;
  border: 2px solid white;
  border-radius: 50%;
  transform: translate(13px, 13px);
}
.discovery__link {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  gap: 8px;
  margin-top: var(--space-md);
  color: var(--ink);
  font-size: 15px;
  font-weight: 600;
}
.discovery__link:hover {
  color: var(--red);
}
.contrib-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3xl);
  align-items: start;
}
.contrib-header .eyebrow {
  margin-bottom: var(--space-md);
}
.contrib-header__subtitle {
  color: var(--muted);
  font-size: 17px;
  line-height: 1.7;
  margin-bottom: var(--space-xl);
}
.contrib-header__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}
.contrib-steps {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}
.contrib-step {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: var(--space-lg) var(--space-xl);
}
.contrib-step__icon {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-md);
  background: var(--red-soft);
  color: var(--red);
}
.contrib-step__title {
  color: var(--ink);
  font-size: 15px;
  font-weight: 700;
  margin-bottom: var(--space-2xs);
}
.contrib-step__desc {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.55;
}
@media (max-width: 767px) {
  .hero {
    padding-top: 80px;
  }
  .hero__inner, .discovery {
    display: block;
  }
  .hero__content {
    padding-bottom: 48px;
  }
  .server-card {
    width: auto;
    transform: translateY(0);
    margin-bottom: 48px;
  }
  .flow, .capabilities {
    grid-template-columns: 1fr;
  }
  .flow__arrow {
    transform: rotate(90deg);
    justify-self: center;
  }
  .discovery__card {
    margin-top: var(--space-xl);
  }
  .contrib-layout {
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }
  .hero__actions .btn, .contrib-header__actions .btn {
